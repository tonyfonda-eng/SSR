  {
    "schema_id": "SCHEMA.FIN.CURRENCY_AMOUNT",
    "version": "1.0",
    "name": "Standardized Currency Metric",
    "layer": "Financial",
    "fields": [
      {
        "name": "amount",
        "datatype": "float",
        "required": true,
        "description": "Absolute quantitative value"
      },
      {
        "name": "currency_code",
        "datatype": "string",
        "required": true,
        "description": "ISO 4217 currency block code"
      },
      {
        "name": "gross_net",
        "datatype": "string",
        "required": true,
        "description": "Gross or Net treatment status"
      },
      {
        "name": "per_share",
        "datatype": "boolean",
        "required": true,
        "description": "True if unit evaluated per share"
      }
    ],
    "validation_rules": [
      "amount >= 0.0",
      "currency_code matches ^[A-Z]{3}$"
    ],
    "maturity": "Verified"
  },
